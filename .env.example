# ====== 光离 环境变量示例 ======
# 复制为 .env 并修改后使用（docker compose 会自动读取 deploy/.env）

# JWT 签名密钥（必填，生产环境请使用足够随机的长字符串）
# 生成示例：openssl rand -base64 48
AUTH_SECRET=please-change-me-to-a-long-random-string

# 初始管理员密码（首次启动时写入，之后请在设置页修改）
ADMIN_PASSWORD=guangli-admin

# 运行时数据目录（settings/usage/auth/versions/assistant）
DATA_DIR=./data

# 受管工作区根目录（文件管理 / Soul 扫描的沙箱根）
WORKSPACE_DIR=./workspace-demo

# 部署域名（Caddy 使用；本地开发可留 localhost）
DOMAIN=localhost

# 生产环境置 1：信任反向代理头（x-forwarded-for / proto），并启用 Secure cookie
TRUST_PROXY=0
